# Copy to .env; never commit real credentials.
CLOVA_API_KEY=
CLOVA_MODEL=HCX-007
CLOVA_BASE_URL=https://clovastudio.stream.ntruss.com/v1/openai
CLOVA_MAX_COMPLETION_TOKENS=4096

# Explicit PDF table extraction: hybrid (default) or pdfplumber (comparison tests)
SP_TABLE_BACKEND=hybrid

# Experimental independent semantic batching; default/rollback: legacy
# Does not skip LLM judgement. Cold/live accuracy and latency still require validation.
SP_PERMIT_SEMANTIC_MODE=legacy

# Optional Gmail ingestion (not required for direct upload)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
